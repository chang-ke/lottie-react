{
  "name": "lottie-react",
  "version": "3.0.0-beta.0",
  "description": "A lightweight React library for rendering complex After Effects animations in real time using Lottie.",
  "keywords": [
    "lottie",
    "lottie react",
    "lottie animation",
    "react animation",
    "lottie component",
    "lottie hook",
    "lottie player"
  ],
  "homepage": "https://lottiereact.com",
  "bugs": {
    "url": "https://github.com/Gamote/lottie-react/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gamote/lottie-react.git"
  },
  "license": "MIT",
  "author": "David Gamote",
  "type": "module",
  "types": "build/index.d.ts",
  "main": "build/index.js",
  "module": "build/index.esm.js",
  "exports": {
    ".": {
      "import": "./build/index.esm.js",
      "require": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "files": [
    "build"
  ],
  "workspaces": [
    ".",
    "example"
  ],
  "scripts": {
    "typecheck": "yarn tsc --noEmit",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "yarn format:check --write",
    "lint:check": "eslint .",
    "lint": "yarn lint:check --fix",
    "lint:inspect": "eslint --inspect-config",
    "build": "rollup --config rollup.config.mts --configPlugin @rollup/plugin-typescript --configImportAttributesKey with",
    "build:watch": "yarn build -w",
    "dev": "concurrently \"yarn build:watch\" \"yarn workspace lottie-react-example dev\"",
    "postbuild": "npm pack && tar -xvzf *.tgz && rm -rf package *.tgz",
    "prepublishOnly": "rm -rf build && yarn build",
    "test": "echo TBI"
  },
  "dependencies": {
    "lottie-web": "^5.13.0",
    "react-fast-compare": "^3.2.2"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "jiti": "^2.6.1",
    "less": "^4.5.1",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "rollup": "^4.59.0",
    "rollup-plugin-delete": "^3.0.2",
    "rollup-plugin-dts": "^6.3.0",
    "rollup-plugin-postcss": "^4.0.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "engines": {
    "node": "^18.18.0 || ^19.8.0 || >= 20.0.0"
  },
  "packageManager": "yarn@4.9.1"
}
