{
  "name": "lottie-react",
  "version": "3.0.0-beta.0",
  "description": "A lightweight React library for rendering complex After Effects animations in real time using Lottie.",
  "keywords": [
    "lottie",
    "lottie react",
    "lottie animation",
    "react animation",
    "lottie component",
    "lottie hook",
    "lottie player"
  ],
  "homepage": "https://lottiereact.com",
  "bugs": {
    "url": "https://github.com/Gamote/lottie-react/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gamote/lottie-react.git"
  },
  "license": "MIT",
  "author": "David Gamote",
  "type": "module",
  "types": "build/index.d.ts",
  "main": "build/index.js",
  "module": "build/index.esm.js",
  "files": [
    "build"
  ],
  "workspaces": [
    ".",
    "example"
  ],
  "scripts": {
    "typecheck": "yarn tsc -w --noEmit",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "yarn format:check --write",
    "lint:check": "eslint .",
    "lint": "yarn lint:check --fix",
    "lint:inspect": "eslint --inspect-config",
    "build": "rollup -c",
    "build:watch": "rollup -c -w",
    "dev": "concurrently \"yarn build:watch\" \"yarn workspace lottie-react-example dev\"",
    "postbuild": "npm pack && tar -xvzf *.tgz && rm -rf package *.tgz",
    "prepublishOnly": "rm -rf build && yarn build",
    "eslint": "eslint .",
    "eslint:fix": "eslint . --fix",
    "test": "echo TBI"
  },
  "dependencies": {
    "lottie-web": "^5.13.0",
    "react-fast-compare": "^3.2.2"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/eslint-plugin-jsx-a11y": "^6.10.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.4.1",
    "eslint-plugin-import-x": "^4.13.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "jiti": "^2.4.2",
    "less": "^4.3.0",
    "postcss": "^8.5.4",
    "prettier": "^3.5.3",
    "rollup": "^4.41.1",
    "rollup-plugin-delete": "^3.0.1",
    "rollup-plugin-dts": "^6.2.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-uglify": "^6.0.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0"
  },
  "engines": {
    "node": "^18.18.0 || ^19.8.0 || >= 20.0.0"
  },
  "packageManager": "yarn@4.9.1"
}
